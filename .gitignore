# 依赖(由 dsh 宿主提供,不提交)
node_modules/
.pnpm-store/

# 打包产物(本地安装用的 tarball,用 pnpm pack 现场生成)
*.tgz

# 验证脚本的运行态输出
verify-kernel.json

# GitHub Actions 工作流:推送 workflow 文件需要 token 具备 `workflow` scope,
# 当前 gh 凭据没有该 scope(GitHub 会拒绝整次 push),所以暂时不跟踪。
# 启用方式:gh auth refresh -h github.com -s workflow,然后删掉这一行重新提交。
.github/

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
pnpm-debug.log*
